# direnv 环境文件：为 cargo 构建（highs-sys 默认特性）提供工具链依赖。
# 来源均为仓库 .venv（PyPI 包 cmake / libclang 自带的二进制，见
# requirements.txt 注释：依赖安装统一走 UV + 国内镜像源）。
# 使用：安装 direnv 后在本目录执行 `direnv allow`；或手动 `source .venv` 外的
# 本文件：`source .envrc`（纯 bash 语法，不依赖 direnv stdlib）。

# bindgen 需要 libclang 共享库（PyPI libclang 包内置，版本随 venv）
export LIBCLANG_PATH="${PWD}/.venv/lib/python3.10/site-packages/clang/native"

# highs-sys 构建脚本经 PATH 调用 cmake（PyPI cmake 包提供 .venv/bin/cmake）
export PATH="${PWD}/.venv/bin:${PATH}"
