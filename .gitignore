# ===== Rust 构建产物（cargo 可重建） =====
/target

# ===== Python 字节码缓存（可再生） =====
__pycache__/
*.pyc
pycache

# ===== Python 虚拟环境（平台相关，跨机拷贝必须重建） =====
.venv/
/venv

# ===== 前端（web/frontend 引入后生效，均可重建） =====
node_modules/
web/frontend/dist/

# ===== 本地运行时数据（SQLite 库/上传件/日志，可重建） =====
*.db
web/data/

# ===== 二进制与平台产物 =====
*.so
*snap

# ===== 编辑器 / IDE 与本地工具配置 =====
.idea
.zcodeignore
.zcode/
